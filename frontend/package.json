{
  "name": "polymath-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:showcase": "cross-env VITE_BUILD=showcase vite",
    "dev:full": "cross-env VITE_BUILD=full vite",
    "dev:live": "cross-env VITE_API_URL=http://127.0.0.1:8765 vite",
    "build": "tsc -b && vite build",
    "build:showcase": "cross-env VITE_BUILD=showcase npm run build",
    "build:full": "cross-env VITE_BUILD=full npm run build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
