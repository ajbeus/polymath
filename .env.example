# Copy to .env (repo root). Vite reads it for the front end; the future backend will too.

# Which lenses are bundled and shown.
#   showcase = worm lab, fusion, math (safe to present, no personal data)
#   full     = every lens in lenses/showcase and lenses/full
VITE_BUILD=showcase

# Backend URL. Leave empty to use the built-in sample data (no backend needed, fine for demos).
# Set to http://127.0.0.1:8765 to use real ingested papers (or run `npm run dev:live`).
VITE_API_URL=

# Display names. Change these instead of editing code.
VITE_APP_NAME=Polymath
VITE_ASSISTANT_NAME=Ada

# --- Backend (backend/app). It reads VITE_BUILD above too, so one flag controls both. ---
# Do not put real keys in this file; copy it to .env, which is git-ignored.

# Optional: raises the PubMed rate limit from 3 to 10 requests/second.
# NCBI_API_KEY=
# Optional: added to the User-Agent so arXiv/NCBI can contact you if your ingest misbehaves.
# CONTACT_EMAIL=
# Optional: SQLite file location (default backend/data/polymath.sqlite) and digest window in days.
# POLYMATH_DB=
# DIGEST_DAYS=7

# Used in a later step, when the Claude rubric scorer is added.
# ANTHROPIC_API_KEY=
